# Copy to sessions/.env and edit. docker compose reads it automatically.

# Game server base URL as the seat containers reach it (the game server's LAN
# IP, not localhost). After changing it: docker compose up -d
PIXEL_CLASH_URL=http://192.168.8.10:8080

# One seat password for ALL seats (basic auth user "player"). 12-64 characters
# of A-Z a-z 0-9 . _ ~ - (no spaces or ':'); four random words are easy for an
# adult to type. Enter the SAME value in the game server's /admin -> Claude
# seats -> Seat password. Players never see it: the game server's proxy adds it.
# Make up your own, e.g. SEAT_SECRET=otter-lamp-quartz-ninety (left empty here
# on purpose: compose refuses to start until you set it). After changing it:
# docker compose up -d, then update /admin.
# (Replaces the old TTYD_PASS_1..8 lines, which are now ignored.)
SEAT_SECRET=

# Optional. Empty = Claude Code's default mode (the kit's .claude/settings.json
# allowlist pre-approves the game tools). The M0 spike decides whether
# acceptEdits is needed so players never see an approval prompt.
# bypassPermissions is deliberately not supported.
CLAUDE_PERMISSION_MODE=

# 1 = after a page reload or restart, Claude reopens the seat's last
# conversation (claude --continue). 0 = always start a fresh conversation.
CLAUDE_CONTINUE=1

# Which coding agent the seats run: claude (Claude Code, the default) or codex
# (OpenAI Codex CLI). Each seat needs its own login for its agent (README).
# After changing it: docker compose up -d
AGENT=claude
# Optional per-seat override, e.g. seats 7 and 8 on Codex:
# SEAT_AGENT_7=codex
# SEAT_AGENT_8=codex

# Codex seats only. danger-full-access (default): Codex's own sandbox needs
# Linux user namespaces, which these locked-down containers don't have, so the
# container is the boundary (as for Claude Code). workspace-write only if
# `docker compose run --rm seatN check` says the Codex sandbox works.
CODEX_SANDBOX=danger-full-access
# never (default): players never see an approval question. on-request lets
# Codex ask (e.g. before network commands).
CODEX_APPROVAL=never
# Optional: an OpenAI API key for Codex seats that aren't logged in yet (use a
# project key with a spending limit; README "Codex seats"). Leave empty to log
# each seat in with `codex login --device-auth` instead.
OPENAI_API_KEY=
