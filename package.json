{
  "name": "pixel-clash",
  "version": "0.1.0",
  "private": true,
  "description": "LAN auto-battler where players design units by prompting Claude Code",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @pixel-clash/shared && npm run build -w @pixel-clash/server && npm run build -w @pixel-clash/client",
    "start": "node scripts/start.mjs",
    "test": "vitest run && npm run test:perf",
    "test:perf": "node scripts/test-perf.mjs",
    "balance": "tsx --conditions=source scripts/balance.ts",
    "balance:exploit": "tsx --conditions=source scripts/balance-exploit.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/client/tsconfig.json --noEmit",
    "loadtest": "tsx --conditions=source tests/load/loadtest.ts",
    "bots": "tsx --conditions=source scripts/bots.ts",
    "wipe": "node -e \"require('node:fs').rmSync('data',{recursive:true,force:true});console.log('data/ deleted')\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "vite": "8.3.2"
  }
}
